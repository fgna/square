{
  "name": "square",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "cd apps/api && pnpm prisma migrate dev",
    "db:seed": "cd apps/api && pnpm prisma db seed",
    "db:studio": "cd apps/api && pnpm prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:i18n": "node scripts/audit-web-translations.mjs --strict",
    "plugins:sync": "node scripts/plugins.mjs",
    "test:plugins": "node --test scripts/plugins.test.mjs",
    "test:sdk": "node --test packages/plugin-sdk/src/tasks.test.mjs packages/plugin-sdk/src/adaptive.test.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "multer": ">=2.3.0",
      "lodash": ">=4.18.0",
      "sharp": ">=0.35.4",
      "js-yaml": ">=4.3.2",
      "nanoid": ">=3.3.18",
      "browserslist": ">=4.28.7",
      "deepmerge-ts": ">=8.0.0",
      "postcss": ">=8.5.18"
    }
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "lowlight": "^3.3.0"
  },
  "license": "Apache-2.0"
}

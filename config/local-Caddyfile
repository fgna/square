{
  admin off
  auto_https disable_redirects
}
https://{$COMMUNITY_LAN_IP}:{$COMMUNITY_HTTPS_PORT} {
  tls internal

  handle /health {
    reverse_proxy 127.0.0.1:{$COMMUNITY_API_PORT}
  }

  handle {
    reverse_proxy 127.0.0.1:{$COMMUNITY_WEB_PORT}
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
}
